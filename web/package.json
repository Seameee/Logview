{
  "name": "logview-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Logview 前端：单页日志查看器，只通过 /api/stream 读取投影后的事件。",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test test/logic.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
}
