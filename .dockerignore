# 构建上下文裁剪：镜像里需要的一切都由 Dockerfile 显式 COPY。

.git
.github
.gitignore

# 前端依赖与产物在镜像内重新安装/构建
web/node_modules
web/dist
web/.vite
web/**/*.tsbuildinfo

# 本地构建产物
dist
logview
*.test

# Go 内嵌目录由 web 阶段产物覆盖，本地内容不进入上下文
internal/server/dist

# 文档与脚本不参与镜像构建
README.md
AGENTS.MD
AGENTS.md
scripts
testdata

.DS_Store
.idea
.vscode
